{
  "name": "amazona",
  "version": "1.0.0",
  "description": "Full-Stack E-Commerce Web Application built with React, Node.js, and Spring Boot",
  "main": "index.js",
  "dependencies": {
    "aws-sdk": "^1.18.0",
    "body-parser": "^1.19.0",
    "dotenv": "^8.2.0",
    "eslint-plugin-react": "^7.19.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^1.4.2",
    "multer-s3": "^2.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.8.4",
    "@babel/node": "^7.8.4",
    "@babel/preset-env": "^7.8.4",
    "eslint": "^10.7.0",
    "eslint-config-airbnb": "^18.1.0",
    "eslint-plugin-import": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react-hooks": "^2.5.1",
    "nodemon": "^2.0.2"
  },
  "scripts": {
    "start": "cd spring-backend && mvnw.cmd spring-boot:run",
    "start:node": "nodemon --watch backend --exec babel-node backend/server.js",
    "start:spring": "cd spring-backend && mvnw.cmd spring-boot:run",
    "start:frontend": "cd frontend && npm start",
    "build": "cd spring-backend && mvnw.cmd clean package -DskipTests && cd ../frontend && npm install && npm run build"
  },
